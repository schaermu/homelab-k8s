machine:
  userVolumes:
    - name: longhorn
      provisioning:
        diskSelector:
          match: disk.dev_path == '/dev/sdb' && !system_disk
        minSize: "400GiB"
        grow: true
  kubelet:
    extraMounts:
      - destination: /var/mnt/longhorn
        type: bind
        source: /var/mnt/longhorn
        options:
          - bind
          - rshared
          - rw
